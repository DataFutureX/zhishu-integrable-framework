<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.datafuturex.yunqi</groupId>
        <artifactId>yqap</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>yqap-core</artifactId>
    <name>YunQi Application Platform · Core</name>
    <description>启动壳与基础设施（配置、资源、装配）</description>

    <dependencies>
        <dependency>
            <groupId>cn.datafuturex.yunqi</groupId>
            <artifactId>yqap-api</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.datafuturex.yunqi</groupId>
            <artifactId>yqap-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.datafuturex.yunqi</groupId>
            <artifactId>yqap-biz</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.datafuturex.yunqi</groupId>
            <artifactId>yqap-test-support</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>cn.datafuturex.yunqi.YqapApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*ApiIT.java</include>
                    </includes>
                    <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=${console.encoding} -Dstderr.encoding=${console.encoding} -Dsun.stdout.encoding=${console.encoding} -Dsun.stderr.encoding=${console.encoding} -DCONSOLE_LOG_CHARSET=${console.encoding}</argLine>
                    <encoding>UTF-8</encoding>
                    <systemPropertyVariables>
                        <file.encoding>UTF-8</file.encoding>
                        <stdout.encoding>${console.encoding}</stdout.encoding>
                        <stderr.encoding>${console.encoding}</stderr.encoding>
                        <CONSOLE_LOG_CHARSET>${console.encoding}</CONSOLE_LOG_CHARSET>
                        <yqap.version>${project.version}</yqap.version>
                        <yqap.name>云起应用平台</yqap.name>
                        <yqap.englishName>YunQi Application Platform (YQAP)</yqap.englishName>
                        <spring-boot.version>${spring-boot.version}</spring-boot.version>
                        <api.test.report.dir>${project.build.directory}/api-test-report</api.test.report.dir>
                        <api.test.report.docs.dir>${maven.multiModuleProjectDirectory}/../docs/api-test-report</api.test.report.docs.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
