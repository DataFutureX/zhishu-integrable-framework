# 生产环境
NODE_ENV=production
# 同域反代部署（见 deployment/README.md）：代码里拼成 `${VITE_API_BASE_URL}/v1`，
# 而后端路由自带 /api 前缀且无 context-path，因此这取 /api 即可让浏览器全程同源（无需 CORS）。
# nginx 侧对应 location ^~ /api/（原样透传）与 /api/uploads/、/api/mcp（改写为后端 /uploads、/mcp）。
# 如改成完整域名（如 https://api.example.com），则前后端分域，需先给后端补 CORS 配置。
VITE_API_BASE_URL=/api

# AI 流式（SSE）超时，单位毫秒；不配置则默认 5 分钟（300000），0 表示不限制
# 注意：若网关（如 Nginx proxy_read_timeout）超时小于此值，连接会先被网关切断
# VITE_AI_SSE_FIRST_BYTE_TIMEOUT_MS=300000
# VITE_AI_SSE_IDLE_TIMEOUT_MS=300000
