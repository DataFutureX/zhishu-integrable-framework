# 知枢后端 Docker 部署环境变量样例
# 用法：cp .env.example .env（Windows：Copy-Item .env.example .env），填写必填项后 docker compose up -d
# 注意：值中出现 $ 需写成 $$，否则会被 docker compose 当作变量插值展开。

# ==== Compose / 容器层（非 Spring 配置）====
# 镜像 tag，对应 zhishu-backend/pom.xml 的 project.version
ZHISHU_VERSION=1.0.0
# 宿主机发布端口
APP_PORT=8180
# 容器内 Spring Boot 监听端口（覆盖 application-prod.yml 的 ${SERVER_PORT:8080}）
SERVER_PORT=8180
# 容器内存上限：2G 堆 + 约 1G 余量；调大 JAVA_OPTS 的 -Xmx 时同步调大此项
MEM_LIMIT=3g
TZ=Asia/Shanghai
# 整体覆盖 JVM 参数时请保留 -Dfile.encoding=UTF-8 等编码参数与 -Djava.awt.headless=true
# JAVA_OPTS=-Xms1g -Xmx2g -Djava.awt.headless=true -Dfile.encoding=UTF-8
# 容器在 /app/deploy（即宿主机 deployment/app）里匹配 jar 的文件名模式；有多个时取修改时间最新的
# JAR_GLOB=zhishu-core-*.jar

# ==== 必填：数据源（外部 PostgreSQL，需已执行 db/init.sql 与 db/init_ai.sql）====
# PostgreSQL 跑在宿主机时用 host.docker.internal（compose 已配 host-gateway）
YUNQI_DB_HOST=host.docker.internal
YUNQI_DB_PORT=5432
YUNQI_DB_NAME=zhishu_integrable_framework
YUNQI_DB_USERNAME=postgres
YUNQI_DB_PASSWORD=

# application-prod.yml 把 params 写死为 sslmode=require；目标库不支持 SSL 时必须覆盖，
# 否则报 "The server requested password-based authentication, but it was rejected" 或 SSL 握手失败。
YUNQI_DATASOURCE_PARAMS=sslmode=disable
# 也可整体指定 JDBC URL（优先级高于 host/port/database/params，见 YunqiDataSourceProperties.resolveJdbcUrl）
# YUNQI_DATASOURCE_JDBC_URL=jdbc:postgresql://192.168.11.14:5432/letswork-dev?sslmode=disable
# 连接池（prod 默认 50/10，可按需覆盖 yunqi.datasource.pool.*）
# YUNQI_DATASOURCE_POOL_MAXIMUM_POOL_SIZE=20
# YUNQI_DATASOURCE_POOL_MINIMUM_IDLE=5

# ==== 必填：密钥（留空或沿用默认值即失去生产安全性）====
# application-prod.yml 中 jwt.secret 为 ${JWT_SECRET} 且无默认值，缺失将启动失败；至少 32 字节随机串
JWT_SECRET=
# 加密「模型设置」页面入库的 API Key 的包装密钥；一旦使用不可再改，否则已存 Key 无法解密
ZHISHU_AI_CRYPTO_KEY=
# Desktop API 鉴权 Key（空 = 不鉴权，仅限开发）；请求头 X-Desktop-Key
ZHISHU_DESKTOP_AUTH_KEY=

# ==== 可选：功能开关（均有代码默认值，不填即按默认）====
# MCP 无静态共享密钥：/mcp 凭据为每 Client 的 wxmcp_*（控制台签发）或平台登录 JWT
ZHISHU_MCP_SERVER_ENABLED=true
ZHISHU_DESKTOP_ENABLED=true
# 知识图谱 GraphRAG。无 Neo4j 时 Neo4jSupport 会捕获异常并降级（不影响主链路），
# 但启动日志会打印 Driver 初始化失败；纯降级部署建议置 false 消除噪音
WANXIANG_KG_ENABLED=false
# WANXIANG_AGENT_ENGINE=chatclient

# 仅当 WANXIANG_KG_ENABLED=true 时填写
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j

# 仅作 Spring AI 自动配置占位；正式模型 Key 请在系统「模型设置」页面配置（加密存库）
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_CHAT_MODEL=qwen-plus
# OPENAI_EMBEDDING_MODEL=text-embedding-v4

# ==== 可选：伙伴 SSO（prod 默认关闭）====
YUNQI_SSO_ENABLED=false
# YUNQI_SSO_AUDIENCE=zhishu-integrable-framework
# YUNQI_SSO_DEFAULT_REDIRECT=/ai/chat
# YUNQI_SSO_WANXIANG_ENABLED=true
# YUNQI_SSO_WANXIANG_PUBLIC_KEY=classpath:sso/wanxiang.pem
# YUNQI_SSO_SHUZHI_IOT_ENABLED=true
# YUNQI_SSO_SHUZHI_IOT_PUBLIC_KEY=classpath:sso/shuzhi-iot.pem

# ==== 简报已跳出平台：由外部自行调度并调用 /open/v1/chat（原 ZHISHU_BRIEFING_* 变量已废弃）====
