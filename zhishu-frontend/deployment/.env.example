# 知枢前端 Nginx 部署环境变量样例
# 用法：cp .env.example .env，按需修改后执行 ./scripts/deploy-web.sh
# 注意：值中出现 $ 需写成 $$，否则会被 docker compose 当作变量插值展开。

# 镜像：本方案不自建镜像，直接用官方 nginx
NGINX_IMAGE=nginx:1.27-alpine

# 宿主机对外发布端口（先确认未被占用：ss -lntp | grep :80）
WEB_PORT=80
HTTPS_PORT=443
# 容器内 nginx 监听端口（健康检查也用此端口）
NGINX_HTTP_PORT=80
TZ=Asia/Shanghai

# 站点 Host 匹配；_ 表示任意域名都可访问，正式上线建议填具体域名
NGINX_SERVER_NAME=_

# 后端地址（对应 zhishu-backend/deployment 的 APP_PORT，默认 8180）
#   后端容器发布在宿主机：host.docker.internal:8180
#   与后端共用 Docker 网络时：zhishu-app:8180
#   后端在另一台机器：10.0.0.5:8180
BACKEND_UPSTREAM=host.docker.internal:8180

# HTTPS 开关：true 前需把证书放到 deployment/certs/fullchain.pem 与 privkey.pem
ENABLE_HTTPS=false
