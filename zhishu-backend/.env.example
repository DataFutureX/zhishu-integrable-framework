# 复制为 backend/.env 后按需填写。
# 模型 API Key 请在系统「模型设置」页面配置（加密存库），不要写进 application.yml。

# 用于加密入库模型 Key 的包装密钥（生产务必修改）
ZHISHU_AI_CRYPTO_KEY=zhishu-dev-model-key-wrap

# 可选：首次启动前的兼容回退（页面保存 Key 后不再依赖此项）
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_CHAT_MODEL=qwen-plus
# OPENAI_EMBEDDING_MODEL=text-embedding-v4
